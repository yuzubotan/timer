<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <style>
      button, span {
        margin: 0;
        padding: 0;
      }

      html {
        max-width: 900px;
      }
      body {
        background-color: #bcffff;
        font-family: Arial, sans-serif;
        overflow: hidden; /* スクロールバーを隠す */
      }
  
      .timeline-container {
        position: relative;
        width: 400px; /* タイムラインの幅 */
        height: 3000px;
        margin: 0 auto;
        border: 1px solid;
        display: flex;
        justify-content: left;
        background-color: #f0f0f0;
        overflow: scroll;
        
      }
  
      .timeline {
        position: absolute;
        top: 50px;
        left: 50px;
        width: 2px; /* 直線の幅 */
        background-color: #333; /* 直線の色 */
        height: 30000px; /* タイムラインの高さを設定 */
        
      }
  
      .time-marker {
        position: absolute;
        left: -40px; /* 直線からの距離 */
        font-size: 14px;
        color: #333;
        transform: translateY(-50%);
      }
        
      header {
        width: 96%;
        height: 60px;
        position: sticky;
        z-index: 10;
      }
        
      .header {
          font-weight: bold;
          background-color: white;
          border-radius: 10px;
          width: 93px;
          height: 46px;
          line-height: 46px;
          display: inline-block;
          font-size: 16px;
          text-align: center;
      }

      #switch {
          float:right;
      }

      .data-item {
      position: absolute;
      display: flex;
      justify-content: center;
      width: 300px;
      left: 55px;
      font-size: 15px;
      color: #333;
      transform: translateY(-50%);
      align-items: flex-start;
    }

      .point {
        color: red;
        position: absolute;
        left: -15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 30px

      }
    
      .id {
        border: 1px solid;
        background-color: white;
        display: inline-block;
        width: 40px;
        height: 50px;
        font-size: 30px;
        font-weight: bold;
        line-height: 50px;
        text-align: center;
        margin-right: 5px;
      }

      .bt {
        border: 1px solid;
        background-color: white;
        width: 50px;
        height: 50px;
        display: inline-block;
        margin-right: 5px;
      }

      
      .order {
        border: 1px solid;
        background-color: white;
        min-height: 50px;
        height: auto;
        line-height: normal;
        display: inline-block;
        margin-right: 5px;
        padding: 5px;
        box-sizing: border-box;
      }



      .data-item {
        transition: opacity 0.2s;
      }

      .data-item.processing {
        opacity: 0.5;
      }

      .data-item.done {
        opacity: 0.3;
      }

      .data-item.processing .ok,
      .data-item.done .ok {
        pointer-events: none;
        opacity: 0.5;
      }

      .timeline2 {
          position: relative;
          width: 400px;
          min-width: 400px;
          flex: 0 0 400px;
      }

      #tail-line {
          position: absolute;
          left: 0;
          top: 500px;
          width: 400px;
          height: 3px;
          background-color: red;
          z-index: 1000;
          pointer-events: none;
      }

      #tail-line span {
          position: absolute;
          right: 0;
          bottom: 3px;
          background-color: white;
          color: red;
          font-size: 12px;
          padding: 2px 5px;
          white-space: nowrap;
      }

      .checked-button {
          display: block;
          margin: 4px 0;
          padding: 4px 8px;
          font-size: 12px;
          cursor: pointer;
      }

      
      
      .merged-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        max-width: 100%;
        overflow: visible;
        padding: 4px 0;
        box-sizing: border-box;
      }

      .merged-buttons .merged-item-button {
        flex: 0 1 auto;
        white-space: normal;
        font-size: 12px;
        padding: 4px 6px;
      }



        
    </style>
</head>
<body>
    <header>
        <span id="order" class="header" onclick="location.href='/order'">注文履歴</span>
        <span id="switch" class="header" onclick="location.href='/'">switch</span>
    </header>
    <span id="wait_time">0:00:00</span>
    <button id="reload">最新の情報に更新</button>
    <div class="timeline-container">
        <div class="timeline" style="top:300px">
          
      
        </div>
        <div class="timeline2">
          <% for (const item of data) { %>
            <% 
              const currentTime = new Date();
              let itemTop = 500 + ((Math.floor(item.hour * 12) + Math.floor(item.minutes / 5)) * 200 + (item.minutes % 5) * 40) - ((currentTime.getHours() * 12 + Math.floor(currentTime.getMinutes() / 5)) * 200  + (currentTime.getMinutes() % 5 * 40));
            %>
            <% console.log('注文:', item.id, '予約:', item.reservation, 'checked:', item.checked) %>
            <% if(itemTop >= 0) { %>
              <div class="data-item <%= item.done == 1 ? 'done' : '' %>" style="top: <%= itemTop %>px">
                <span class="point">●</span><span class="id"><%= item.id %></span>
                <div class="order" style="<%= item.reservation === 1 ? (item.checked == 1 ? 'background-color: yellow;' : 'background-color: lightblue;') : '' %>">
                  開始:<%= item.startTime %> 本数:<%= item.number %>
                  <% if(item.reservation === 1) { %>
                    <br>予約:<%= item.reserveTime %>

                    <button type="button" class="checked-button" onclick="toggleChecked(this, <%= item.id %>)"
                      data-checked="<%= Number(item.checked) === 1 ? 1 : 0 %>">
                        <%= Number(item.checked) === 1 ? '未' : '済' %>                      
                    </button>
                    
                    <% if (item.merged_from) { %>
                      <div class="merged-info">
                        （ID: <%= item.merged_from %>）
                      </div>
                    <% } %>

                    <% if (
                      item.reservation === 1 &&
                      item.mergedItems &&
                      item.mergedItems.length > 1
                    ) { %>
                      <div class="merged-buttons">
                        <% for (const member of item.mergedItems) { %>
                          <button
                            type="button"
                            class="merged-item-button"
                            style="<%= Number(member.completed) === 1
                              ? 'background-color: lightgreen;'
                              : 'background-color: white;' %>"
                            onclick="completeMergedItem(this, <%= item.id %>, <%= member.id %>, <%= item.number %>)">
                            ID <%= member.id %>
                            （<%= member.number %>本）
                            <%= Number(member.completed) === 1 ? '完了' : '未完了' %>
                          </button>
                        <% } %>
                      </div>
                    <% } %>


                  <% } %>
            </div>
                
            <button
              class="bt ok"
              <%= item.done == 1 ? 'disabled' : '' %>
              style="<%= item.mergedItems && item.mergedItems.length > 1
                ? 'display:none;'
                : '' %>"
              <%- item.done == 1 ? '' : 'onclick="modify(this, ' + item.id + ', ' + item.number + ')"' %>>
              OK
            </button>

                

              </div>
            <% } %>
          <% } %>
          <div id="tail-line">
            <span id="tail-time">--:-- 待ち時間の最後尾</span>
          </div>
        </div>
        
        
    </div>
    <script>
      const protocol = location.protocol === 'https:' ? 'wss' : 'ws';
      const socket = new WebSocket(`${protocol}://${location.host}`);

      socket.onmessage = function(event) {

    console.log("WS received:", event.data);

    document.getElementById('reload').addEventListener('click', ()=>{
      window.location.reload();
    })

    // JSON に変換
    const message = JSON.parse(event.data);

    if(message.type === "update") { 
      timerValue = message.timerValue; 
      let hours = Math.floor(timerValue / 3600); 
      let minutes = Math.floor((timerValue % 3600) / 60); 
      let seconds = timerValue % 60; 
      document.getElementById('wait_time').textContent = 
      `${String(hours).padStart(1, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`; }
      updateTailLine();

    // --- デバッグログ ---
    console.log("action:", message.action);
    console.log("message.action === 'modify' ?", message.action === 'modify');
    console.log("message.action === 'del' ?", message.action === 'del');

    // --- modify の処理 ---
    console.log(message.action)
    if (message.type === 'modify') {
        console.log('modify 受信 → 加算実行', timerValue);
        
        timerValue += message.amount;

        socket.send(
            JSON.stringify({
                action: 'increase',
                amount: message.amount
            })
        );
    }


    // --- del の処理 ---
    if (message.action === 'del') {
        console.log('del 受信 → 加算実行', timerValue);

        socket.send(
            JSON.stringify({
                action: 'increase',
                amount: message.amount
            })
        );
    }
};

async function toggleChecked(button, id) {
    if (button.disabled) return;

    button.disabled = true;

    try {
        const response = await fetch(
            `/timeline/toggle-checked?id=${id}`,
            { method: 'POST' }
        );

        if (!response.ok) {
            throw new Error('更新に失敗しました');
        }

        const result = await response.json();

        // 更新後のcheckedの値を保存
        button.dataset.checked = result.checked;

        // 予約注文の背景色を変更
        const order = button.closest('.order');

        if (order) {
            order.style.backgroundColor =
                result.checked === 1 ? 'yellow' : 'lightblue';
        }

         // ボタンの文字を変更
        button.textContent =
            result.checked === 1 ? '未確認に戻す' : '確認済みにする';

    } catch (error) {
        console.error(error);
        alert('更新に失敗しました。もう一度お試しください。');
    } finally {
        button.disabled = false;
    }
}


function updateTailLine() {
  const tailLine = document.getElementById('tail-line');
  const tailTime = document.getElementById('tail-time');

  if (!tailLine || !tailTime) return;

  const finishTime = new Date(Date.now() + timerValue * 1000);

  const hours = String(finishTime.getHours()).padStart(2, '0');
  const minutes = String(finishTime.getMinutes()).padStart(2, '0');

  // 注文カードと同じ座標系で元の位置を計算
  const basePosition = 500 + (timerValue / 60) * 40;

  // 注文の重なりを避けるための余白も適用
  tailLine.style.top =
    `${expandedPosition(basePosition)}px`;

  tailTime.textContent =
    `${hours}:${minutes} 待ち時間の最後尾`;
}



async function completeMergedItem(button, masterId, memberId, number) {
  // 通信中の連続クリックを防ぐ
  if (button.dataset.processing === '1') return;

  button.dataset.processing = '1';
  button.disabled = true;

  try {
    const response = await fetch(
      '/timeline/complete-merged-item',
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          masterId,
          memberId
        })
      }
    );

    if (!response.ok) {
      throw new Error('個別注文の更新に失敗しました');
    }

    const result = await response.json();

    // 完了したボタンの色と表示を変更
    button.style.backgroundColor = 'lightgreen';
    button.textContent =
      `ID ${memberId} （完了）`;

    // 全注文が完了した場合だけ既存のOK処理を呼び出す
    if (result.allComplete) {
      const dataItem = button.closest('.data-item');
      const okButton = dataItem.querySelector('.bt.ok');

      if (okButton) {
        await modify(okButton, masterId, number);
      }
    }
  } catch (error) {
    console.error(error);
    alert('個別注文の更新に失敗しました。再度お試しください。');
  } finally {
    button.disabled = false;
    button.dataset.processing = '';
  }
}


async function modify(button, id, number) {

  console.log('modify called, id= ', id); // ← 必ず出る
  if (button.dataset.locked === '1') {
    return;
  }
  button.dataset.locked = '1';

  if (!window.confirm('id=' + id + 'が出来上がりましたか？')) {
    button.dataset.locked = '';

    return;
  }

  // 二度押し防止
  button.disabled = true;

  const dataItem = button.closest('.data-item');
  dataItem.classList.add('processing');

  try {
    const response = await fetch(`/timeline/modify?id=${id}`, {
      method: 'GET'
    });

    if (!response.ok) throw new Error('server error');

    // 成功
    dataItem.classList.remove('processing');
    dataItem.classList.add('done');

    setTimeout(() => {
      window.location.reload();
    }, 200);

  } catch (e) {
    // 失敗時は元に戻す
    alert('通信に失敗しました');
    dataItem.classList.remove('processing');
    button.disabled = false;
    button.dataset.locked = '';
  }
}


            // タイムラインコンテナ
const timeline = document.querySelector('.timeline');
const timeline2 = document.querySelector('.timeline2');
const currentTime = new Date();


/*
 * 注文が重なって追加された縦方向の余白を記録する
 * at: 余白を追加した元の位置
 * offset: そこまでに追加された余白の合計
 */
let timelineExpansionPoints = [];

// 元の位置に追加する余白の量を取得
function getTimelineOffset(baseY) {
  let offset = 0;

  for (const point of timelineExpansionPoints) {
    if (baseY >= point.at) {
      offset = point.offset;
    } else {
      break;
    }
  }

  return offset;
}

// 元の位置を、余白を追加した後の位置に変換
function expandedPosition(baseY) {
  return baseY + getTimelineOffset(baseY);
}


// 初期時間と表示のステップ（5分刻み）
let startTime = new Date(new Date().getTime() - 5 * 60 * 1000);

const stepMinutes = 5; // 5分刻み
const duration =  13 ; // 営業時間(１１時間分)のタイムライン
const totalSteps = duration / (stepMinutes / 60);

// タイムラインに時間マーカーを追加する
for (let i = 0; i <= totalSteps; i++) {
  const marker = document.createElement('div');
  marker.classList.add('time-marker');

  // 時間のフォーマット（hh:mm形式）
  const time = new Date(startTime.getTime() + i * stepMinutes * 60 * 1000);
  const formattedTime = time.getHours().toString().padStart(2, '0') + ':' + time.getMinutes().toString().padStart(2, '0');

  marker.textContent = formattedTime;

  // 元の位置を保存
  const baseTop = i * 200;
  marker.dataset.baseTop = baseTop;
  marker.style.top = `${baseTop}px`;

  timeline.appendChild(marker);
}


// 縦スクロールを時間経過とリンク
let scrollPosition = 0;
const scrollSpeed = 0.007; // スクロールの速さ（px単位）

function scrollTimeline() {
  scrollPosition += scrollSpeed;
  timeline.style.transform = `translateY(-${scrollPosition}px)`;
  timeline2.style.transform = `translateY(-${scrollPosition}px)`;
  
  requestAnimationFrame(scrollTimeline);
}



function preventOrderOverlap() {
  const items = Array.from(
    document.querySelectorAll('.data-item')
  );

  // 注文時刻の順番に並べる
  items.sort((a, b) =>
    parseFloat(a.style.top) - parseFloat(b.style.top)
  );

  timelineExpansionPoints = [];

  let cumulativeOffset = 0;
  let previousBottom = -Infinity;

  const gap = 8;
  const standardHeight = 50;

  for (const item of items) {

    // 注文カードの元の中心位置
    const baseCenter = parseFloat(item.style.top);
    item.dataset.baseTop = baseCenter;

    // カードの実際の高さ
    const height = item.offsetHeight;

    // これまでに追加した余白を反映
    let center = baseCenter + cumulativeOffset;
    let top = center - height / 2;

    // 前のカードと重なる場合
    if (top < previousBottom + gap) {

      const extraSpace = previousBottom + gap - top;

      cumulativeOffset += extraSpace;

      center = baseCenter + cumulativeOffset;
    }

    // カードの位置を変更
    item.style.top = `${center}px`;

    // カード自体が標準より大きい場合の余白
    const extraHeight = Math.max(0, height - standardHeight);

    if (extraHeight > 0) {
      cumulativeOffset += extraHeight;
    }

    // この注文カードの下端から余白を適用
  if (extraHeight > 0 || top < previousBottom + gap) {
    timelineExpansionPoints.push({
      at: baseCenter + height / 2,
      offset: cumulativeOffset
    });
  }

    // 次のカードとの重なりを確認するための位置
    previousBottom = center + height / 2;
  }

  // 時刻マーカーを移動
  document.querySelectorAll('.time-marker').forEach(marker => {

    const baseTop = Number(marker.dataset.baseTop);

    const basePosition = 300 + baseTop;
    const offset = getTimelineOffset(basePosition);

    marker.style.top = `${baseTop + offset}px`;
  });

  // 赤い最後尾ラインを更新
  updateTailLine();

  console.log('余白の記録一覧:', timelineExpansionPoints);
}



preventOrderOverlap();

// スクロールを開始
scrollTimeline();


let timeToAdjust = 0;

function del(id, number) {
          timeToAdjust = number / 10 * 60;
          console.log(timeToAdjust);
        
          let result = window.confirm('id=' + id + 'を削除しますか？');
          if (result) {
            window.location = "/timeline/del?id=" + id;
          }
        }


    </script>
</body>
</html>